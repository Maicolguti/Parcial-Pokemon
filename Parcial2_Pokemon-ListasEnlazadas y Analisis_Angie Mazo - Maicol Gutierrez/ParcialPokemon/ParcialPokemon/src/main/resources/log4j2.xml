<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn" strict="true" name="Log4j2Config">

    <!-- Variables reutilizables para la configuración -->
    <Properties>
        <!-- Carpeta donde se almacenarán los archivos de log -->
        <Property name="app_log_root">logs</Property>
        <!-- Formato de cada mensaje de log -->
        <Property name="log_pattern">%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n</Property>

        <!-- Nombre base del archivo de log -->
        <Property name="log">Analisis</Property>
        <Property name="logperformance">Analisis.Performance</Property>
        <Property name="logtiempos">Analisis.Tiempos</Property>
    </Properties>

    <!-- Destinos donde se escribirán los mensajes -->
    <Appenders>
        <!-- Muestra los logs en la consola -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${log_pattern}"/>
        </Console>

        <!-- Guarda los logs generales en un archivo y los rota cuando sea necesario -->
        <RollingFile name="FileLogger"
                     fileName="${app_log_root}/${log}.log"
                     filePattern="${app_log_root}/${log}-%d{yyyy-MM-dd}-%i.log.gz"
                     append="true">
            <PatternLayout pattern="${log_pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>

        <RollingFile name="FileLoggerTiempos"
                     fileName="${app_log_root}/${logtiempos}.log"
                     filePattern="${app_log_root}/${logtiempos}-%d{yyyy-MM-dd}-%i.log.gz"
                     append="true">
            <PatternLayout pattern="${log_pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>

        <RollingFile name="FileLoggerPerformance"
                     fileName="${app_log_root}/${logperformance}.log"
                     filePattern="${app_log_root}/${logperformance}-%d{yyyy-MM-dd}-%i.log.gz"
                     append="true">
            <PatternLayout pattern="${log_pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>
    </Appenders>

    <!-- Define qué mensajes se registran y a dónde van -->
    <Loggers>
        <!-- Logger raíz: aplica a toda la aplicación -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
        </Root>

        <!-- Logger específico para tu paquete -->
        <Logger name="org.example" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
        </Logger>

        <Logger name="tiempos" level="debug" additivity="false">
            <AppenderRef ref="FileLoggerTiempos"/>
        </Logger>

        <Logger name="performance" level="debug" additivity="false">
            <AppenderRef ref="FileLoggerPerformance"/>
        </Logger>
    </Loggers>
</Configuration>